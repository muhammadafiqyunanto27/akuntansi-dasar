---
import type { Bi } from '../data/types';

interface Props {
  value: Bi | undefined | null;
  class?: string;
}

const { value, class: className = '' } = Astro.props;

const safeValue = value || { en: '', id: '' };
---

<span class={className || undefined}>
  <span class="bi-id" set:html={safeValue.id}></span>
  <span class="bi-en" set:html={safeValue.en}></span>
</span>
