---
import type { Bi } from '../data/types';

interface Props {
  value: Bi;
  class?: string;
}

const { value, class: className = '' } = Astro.props;
---

<span class={className || undefined}>
  <span class="bi-id" set:html={value.id}></span>
  <span class="bi-en" set:html={value.en}></span>
</span>
